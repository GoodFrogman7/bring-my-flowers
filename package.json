{
  "name": "bring-my-flowers-bot",
  "version": "1.0.0",
  "description": "Automated WhatsApp chatbot for flower delivery business",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:baileys": "node dist/index.js baileys",
    "start:twilio": "node dist/index.js twilio",
    "start:cloud": "node dist/index.js cloud",
    "start:enhanced": "node dist/index.js enhanced",
    "start:business": "node dist/index.js business",
    "dev:business": "ts-node src/index.ts business",
    "payment-run": "ts-node scripts/payment-run.ts",
    "dev": "ts-node src/index.ts",
    "dev:baileys": "ts-node src/index.ts baileys",
    "dev:twilio": "ts-node src/index.ts twilio",
    "dev:cloud": "ts-node src/index.ts cloud",
    "dev:enhanced": "ts-node src/index.ts enhanced",
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox": "ts-node scripts/business-sandbox.ts",
    "test:sandbox": "ts-node scripts/business-sandbox.ts --smoke",
    "install:console": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-business-console.ps1",
    "make:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-release.ps1",
    "import:master": "ts-node scripts/import-master.ts",
    "import:feedback": "ts-node scripts/import-feedback.ts",
    "del-sheet": "ts-node scripts/make-del-sheet.ts",
    "verify": "ts-node scripts/verify-setup.ts",
    "verify:enhanced": "ts-node scripts/setup-enhanced.ts",
    "test:ollama": "ts-node scripts/test-ollama.ts",
    "add:sample": "ts-node scripts/add-sample-data.ts",
    "clean": "rm -rf dist sessions backups data/*.xlsx logs temp"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "ollama",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/express": "^5.0.6",
    "@whiskeysockets/baileys": "^6.7.24",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^2.2.1",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "googleapis": "^170.0.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "openai-whisper": "^1.0.2",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "razorpay": "^2.9.6",
    "twilio": "^5.11.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
