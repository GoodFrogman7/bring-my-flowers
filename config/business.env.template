# Bring My Flowers — Owner Console (business mode only)
# Copy to .env on first Setup, then fill the values marked REQUIRED.

BOT_MODE=business
BUSINESS_TRANSPORT=baileys
BUSINESS_DB=./data/business.db
SESSION_PATH=./sessions
BACKUP_PATH=./backups

# REQUIRED — WhatsApp JID of the Updates staff group (...@g.us).
# After linking, send any message in Updates and copy remoteJid from logs if unsure.
UPDATES_GROUP_JID=

# Nightly group processing time (IST)
UPDATES_PROCESS_TIME=21:30

# Optional contact numbers (not used for sheet DMs unless OWNER_SHEET_DM=1)
OWNER_NUMBERS=
# Dashboard is the sheet home — keep this 0 unless you explicitly want WhatsApp DMs
OWNER_SHEET_DM=0
# Nightly .xlsx to the Updates group (staff). Set 0 to disable group upload.
GROUP_SHEET_SEND=1
# Optional summary text in the group before the sheet file
GROUP_NIGHTLY_SUMMARY=0

# Owner dashboard (local only). Set 0 to disable.
DASHBOARD_PORT=8787

# First link: seconds to wait for WhatsApp before exit (QR is also on Settings / /link)
CONNECT_TIMEOUT_SECONDS=900

# Ollama (optional — Claude/local tools cover Q&A without it)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_GPU=0
OLLAMA_KEEP_ALIVE=-1

# Optional cloud Q&A (read-only tools only — never mutates data)
#LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5

LOG_LEVEL=info
