# Bring My Flowers — Owner Console (business mode only)
# Copy to .env on first Setup. Dashboard mode works with the defaults.

BOT_MODE=business
# Simplest path: staff paste updates in the local dashboard. No WhatsApp QR,
# group JID, public webhook, or Ollama is needed.
BUSINESS_TRANSPORT=dashboard
BUSINESS_DB=./data/business.db
SESSION_PATH=./sessions
BACKUP_PATH=./backups

# Set to enable phone/LAN access to the owner console (binds 0.0.0.0 instead
# of 127.0.0.1, and gates every route behind this password). Leave blank to
# keep the console localhost-only with no login.
CONSOLE_PASSWORD=

# Optional legacy path: set BUSINESS_TRANSPORT=baileys and then add the
# WhatsApp JID of the Updates staff group (...@g.us).
UPDATES_GROUP_JID=

# Nightly group processing time (IST)
UPDATES_PROCESS_TIME=21:30

# Optional contact numbers (not used for sheet DMs unless OWNER_SHEET_DM=1)
OWNER_NUMBERS=
# Dashboard is the sheet home — keep this 0 unless you explicitly want WhatsApp DMs
OWNER_SHEET_DM=0
# Nightly .xlsx to the Updates group (staff). Set 0 to disable group upload.
GROUP_SHEET_SEND=1
# Optional summary text in the group before the sheet file
GROUP_NIGHTLY_SUMMARY=0

# Owner dashboard (local only). Set 0 to disable.
DASHBOARD_PORT=8787

# Legacy WhatsApp link timeout. Not used in dashboard mode.
CONNECT_TIMEOUT_SECONDS=900

# Ollama is optional. Business rules and common owner questions work without it.
# Set to 1 only if you want local LLM fallback for unusual messages/questions.
BUSINESS_USE_OLLAMA=0
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_GPU=0
OLLAMA_KEEP_ALIVE=-1

# Optional cloud Q&A (read-only tools only — never mutates data)
#LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5

LOG_LEVEL=info
