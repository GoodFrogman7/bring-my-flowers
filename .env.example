# Copy to .env and fill in what your mode needs.
# Modes: baileys (default) | twilio | enhanced — see docs/SETUP.md
# Select via CLI arg (npm run start:enhanced) or BOT_MODE below.
#BOT_MODE=baileys

# --------------------------------------------
# BUSINESS (all modes)
# --------------------------------------------
# Comma-separated, with country code. These numbers get daily summaries,
# stock alerts, AND the owner command channel (text "help" to the bot).
OWNER_NUMBERS=+919876543210
# Daily summary time, 24-hour format
SUMMARY_TIME=22:00
# When recurring orders materialize into real orders (default 07:00)
#RECURRING_TIME=07:00
# When customers get "your delivery is today" reminders (default 08:30)
#REMINDER_TIME=08:30

# --------------------------------------------
# "UPDATES" GROUP INGESTION (business mode, baileys transport only)
# --------------------------------------------
# JID of the one staff WhatsApp group to read for new one-off orders and
# customer updates ("Hold Neeraj Rathore...") posted by staff. Every other
# group stays ignored. Leave unset to disable the feature entirely.
# To find it: run the bot with the customer-care phone already a member of
# the group, send any message in it, then check logs/app.log for the
# remoteJid the bot logged — copy the "...@g.us" value here and restart.
#UPDATES_GROUP_JID=120363000000000000@g.us
# HH:mm, after the day's group chatter, before staff pull tomorrow's sheet
#UPDATES_PROCESS_TIME=21:30

# --------------------------------------------
# OLLAMA (all modes)
# --------------------------------------------
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3

# --------------------------------------------
# TWILIO (twilio + enhanced modes)
# --------------------------------------------
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Webhook server port
WEBHOOK_PORT=3000

# Public base URL Twilio calls (your ngrok/production https URL).
# Used to verify webhook signatures; update whenever ngrok restarts.
WEBHOOK_BASE_URL=https://your-subdomain.ngrok-free.app
# Set to false ONLY for local curl testing without Twilio signatures
#TWILIO_VALIDATE_WEBHOOK=false

# --------------------------------------------
# GOOGLE CLOUD (enhanced mode)
# --------------------------------------------
# Service account JSON key file (Sheets + Calendar APIs enabled,
# sheet shared with the service account email)
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
# From the sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=

# --------------------------------------------
# RAZORPAY (enhanced mode)
# --------------------------------------------
# API keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay dashboard → Webhooks (NOT the key secret).
# Payment webhooks are rejected until this is configured.
RAZORPAY_WEBHOOK_SECRET=
# Where customers land after paying (set after ngrok starts)
PAYMENT_CALLBACK_URL=https://your-subdomain.ngrok-free.app/payment/success

# --------------------------------------------
# STORAGE / PATHS (optional overrides of config/settings.json)
# --------------------------------------------
#EXCEL_FILE_PATH=./data/business_data.xlsx
#BACKUP_PATH=./backups
#SESSION_PATH=./sessions

# --------------------------------------------
# LOGGING
# --------------------------------------------
LOG_LEVEL=info
